{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    },
    "windows": [
      {
        "decorations": false,
        "fullscreen": true,
        "height": 1080,
        "resizable": true,
        "title": "Sonic Launcher",
        "width": 1920
      }
    ],
    "withGlobalTauri": true
  },
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "targets": "all"
  },
  "identifier": "com.sonic.launcher",
  "productName": "Sonic Launcher",
  "version": "0.1.0"
}